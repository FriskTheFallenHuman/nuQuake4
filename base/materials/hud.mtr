gfx/guis/hud/s_waveform
{	
	noShadows
	translucent
	
	{	
		maskcolor				
	    map	makealpha(gfx/guis/hud/s_waveform_mask.tga)
	}	
	
	{
	    blend GL_DST_ALPHA, GL_ONE
	    maskalpha
		Map   gfx/guis/hud/waveform.tga
		colored
		centerscale	1, wavTable[time * 0.6]
		scroll time * .6, 0
		scale 1, 1
	}
}

gfx/guis/hud/s_ekg
{	
	noShadows
	translucent
	
	{	
		maskcolor				
	    map	makealpha(gfx/guis/hud/s_ekg_mask.tga)
	}
	
	{
	    blend GL_DST_ALPHA, gl_one
	    maskalpha
		Map gfx/guis/hud/s_ekg.tga
		scroll time * -.2, 0
		colored
	}
	
		{
	    blend GL_DST_ALPHA, gl_one
	    maskalpha
		Map gfx/guis/hud/s_ekg2.tga
		scroll time * -.38, 0
		colored
	}
}

